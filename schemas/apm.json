{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/pngdeity/apm-user-repository/main/schemas/apm.json",
  "title": "APM Manifest Schema",
  "description": "JSON Schema for validating apm.yml manifest files (draft-07)",
  "type": "object",
  "required": ["name", "version"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "description": "Package identifier (required). Convention: alphanumeric, dots, hyphens, underscores."
    },
    "version": {
      "type": "string",
      "description": "Semantic version (required). Pattern: ^\\d+\\.\\d+\\.\\d+ (pre-release/build suffixes allowed)",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "description": {
      "type": "string",
      "description": "Brief human-readable description. Inherited by the marketplace block when not overridden."
    },
    "author": {
      "type": "string",
      "description": "Package author or organization."
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier (e.g. MIT, Apache-2.0)."
    },
    "target": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "vscode",
            "agents",
            "copilot",
            "claude",
            "cursor",
            "opencode",
            "codex",
            "gemini",
            "windsurf",
            "all"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vscode",
              "agents",
              "copilot",
              "claude",
              "cursor",
              "opencode",
              "codex",
              "gemini",
              "windsurf",
              "all"
            ]
          },
          "minItems": 1
        }
      ],
      "description": "Controls which output targets are generated during compilation, installation, and packing. Auto-detected from folder presence when omitted."
    },
    "type": {
      "type": "string",
      "enum": ["instructions", "skill", "hybrid", "prompts"],
      "description": "Declares how the package content is processed during install and compile."
    },
    "scripts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Named shell commands executed via 'apm run <name>'. Script body supports {key} placeholder substitution."
    },
    "includes": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["auto"]
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Declares which local .apm/ content is published when packing or deploying. 'auto' or explicit path list."
    },
    "registries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Base URL (HTTPS or HTTP). No trailing slash required."
          }
        },
        "required": ["url"],
        "additionalProperties": false
      },
      "properties": {
        "default": {
          "type": "string",
          "description": "Name of the default registry entry."
        }
      },
      "description": "Declares REST-based APM registries for the project."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apm": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "String shorthand for git URL, registry ID, or local path."
              },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "git": {
                    "type": "string",
                    "description": "Clone URL (HTTPS, SSH) or FQDN shorthand, or 'parent' for monorepo sibling."
                  },
                  "path": {
                    "type": "string",
                    "description": "Virtual path within repo or local filesystem path."
                  },
                  "ref": {
                    "type": "string",
                    "description": "Git reference: branch, tag, or commit SHA."
                  },
                  "alias": {
                    "type": "string",
                    "description": "Local alias for the dependency."
                  },
                  "id": {
                    "type": "string",
                    "description": "Registry package identity (owner/repo)."
                  },
                  "version": {
                    "type": "string",
                    "description": "Version selector (semver range or opaque)."
                  },
                  "registry": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "description": "Registry name or true/false for default registry."
                  }
                }
              }
            ]
          },
          "description": "List of APM package dependencies."
        },
        "mcp": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Registry reference (e.g. io.github.github/github-mcp-server)."
              },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Server identifier (registry name or custom name)."
                  },
                  "transport": {
                    "type": "string",
                    "enum": ["stdio", "sse", "http", "streamable-http"],
                    "description": "Transport protocol (required for self-defined servers)."
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Environment variable overrides. Supports ${VAR}, ${env:VAR}, ${input:<id>} syntax."
                  },
                  "args": {
                    "oneOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ],
                    "description": "Variable overrides (object for registry) or positional args (list for self-defined)."
                  },
                  "version": {
                    "type": "string",
                    "description": "Pin to specific server version."
                  },
                  "registry": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "description": "Registry flag or custom registry URL. true=public (default), false=self-defined."
                  },
                  "package": {
                    "type": "string",
                    "enum": ["npm", "pypi", "oci"],
                    "description": "Package manager type hint."
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Custom HTTP headers for remote endpoints. Supports variable syntax."
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of exposed tools (default: [\"*\"] for all)."
                  },
                  "url": {
                    "type": "string",
                    "description": "Endpoint URL (required for self-defined servers with http/sse/streamable-http)."
                  },
                  "command": {
                    "type": "string",
                    "description": "Binary path (required for self-defined servers with stdio)."
                  }
                },
                "required": ["name"]
              }
            ]
          },
          "description": "List of MCP server dependencies."
        }
      },
      "description": "Dependency declarations (apm packages and mcp servers)."
    },
    "devDependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apm": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "description": "List of development-only APM package dependencies."
        },
        "mcp": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "description": "List of development-only MCP server dependencies."
        }
      },
      "description": "Development-only dependencies (same structure as dependencies)."
    },
    "compilation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "target": {
          "type": "string",
          "description": "Compilation target (e.g., vscode, claude)."
        },
        "strategy": {
          "type": "string",
          "description": "Compilation strategy."
        },
        "output": {
          "type": "string",
          "description": "Output path or directory."
        },
        "chatmode": {
          "type": "string",
          "description": "Chat mode configuration."
        }
      },
      "description": "Compilation settings (target, strategy, output, chatmode fields)."
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fetch_failure_default": {
          "type": "string",
          "enum": ["warn", "block"],
          "description": "Posture when no enforceable policy is available (default: warn)."
        },
        "hash": {
          "type": "string",
          "description": "Pin on the raw bytes of the fetched leaf org policy (format: <algo>:<hex-digest>)."
        },
        "hash_algorithm": {
          "type": "string",
          "enum": ["sha256", "sha384", "sha512"],
          "description": "Digest algorithm for policy.hash (default: sha256)."
        }
      },
      "description": "Consumer-side controls for org policy discovery and verification."
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "owner": {
          "type": "string",
          "description": "Marketplace package owner."
        },
        "build": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ],
          "description": "Build configuration for marketplace output."
        },
        "packages": {
          "oneOf": [
            {
              "type": "array"
            },
            {
              "type": "object"
            }
          ],
          "description": "Packages declared in the marketplace."
        }
      },
      "description": "Marketplace authoring metadata (optional; used by 'apm pack')."
    }
  }
}
