{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/pngdeity/apm-user-repository/main/schemas/apm.json",
  "title": "APM Manifest Schema",
  "description": "JSON Schema for apm.yml files (both root marketplace manifests and package-level manifests). Permissive by design — unknown fields are allowed.",
  "type": "object",
  "required": ["name", "version"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Package or marketplace name (required)"
    },
    "version": {
      "type": "string",
      "description": "SemVer version string (required)",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description"
    },
    "author": {
      "type": "string",
      "description": "Package author"
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier"
    },
    "type": {
      "type": "string",
      "enum": ["instructions", "skill", "hybrid", "prompts"],
      "description": "Package content type for compile and install processing"
    },
    "targets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Target platforms (e.g., opencode, claude, copilot)"
    },
    "includes": {
      "description": "Include pattern — 'auto' or list of repo paths"
    },
    "scripts": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Named shell commands"
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "apm": {
          "type": "array",
          "items": {
            "description": "APM dependency reference (string shorthand or object form)"
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "description": "MCP server reference (string shorthand or object form)"
          }
        }
      },
      "description": "Runtime dependencies"
    },
    "devDependencies": {
      "type": "object",
      "properties": {
        "apm": {
          "type": "array",
          "items": {
            "description": "APM dev dependency reference"
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "description": "MCP dev dependency reference"
          }
        }
      },
      "description": "Development-only dependencies (excluded from apm pack)"
    },
    "compilation": {
      "type": "object",
      "description": "Compilation settings (strategy, target, output, placement, source_attribution)",
      "properties": {
        "target": {
          "description": "Compilation target (string or list of harness slugs)"
        },
        "strategy": {
          "type": "string",
          "enum": ["distributed", "single-file"],
          "description": "Compilation strategy"
        },
        "source_attribution": {
          "type": "boolean",
          "description": "Include source attribution comments"
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Glob patterns to exclude from compilation"
        },
        "placement": {
          "type": "object",
          "description": "Placement configuration (e.g. min_instructions_per_file)",
          "properties": {
            "min_instructions_per_file": { "type": "integer" }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "description": "Consumer-side policy controls"
    },
    "marketplace": {
      "type": "object",
      "description": "Marketplace authoring block (present = this repo publishes a marketplace)",
      "properties": {
        "owner": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          },
          "required": ["name"]
        },
        "build": {
          "type": "object",
          "properties": {
            "tagPattern": { "type": "string" }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "homepage": { "type": "string", "format": "uri" }
          }
        },
        "outputs": {
          "type": "object"
        },
        "versioning": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["lockstep", "tag_pattern", "per_package"],
              "description": "Local-package versioning strategy"
            }
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "source"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "source": { "type": "string" },
              "subdir": { "type": "string" },
              "version": { "type": "string" },
              "ref": { "type": "string" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "homepage": { "type": "string", "format": "uri" },
              "author": { "type": "object" },
              "keywords": {
                "type": "array",
                "items": { "type": "string" }
              },
              "license": { "type": "string" },
              "repository": { "type": "string" },
              "include_prerelease": { "type": "boolean" },
              "tag_pattern": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
